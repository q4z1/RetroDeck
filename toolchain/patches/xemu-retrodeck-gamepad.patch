+// RETRODECK_PAD: the index of the one game controller to play with (RetroDeck
+// passes the pad in use). Its directions come from the left stick and the
+// D-pad together, its fire from A and B, read as SDL's game controller sees
+// them; all other joysticks are left out. Without it, every joystick's every
+// event overwrites the one state: a stick's slight wobble near the middle
+// ended a direction the D-pad still held, any button's release the fire
+// another one still held.
+static int retrodeck_pad_index = -1;
+static SDL_GameController *retrodeck_pad = NULL;

+static void hid_retrodeck_pad_update ( void )
+{
+	unsigned int state = 0;
+	if (retrodeck_pad) {
+		SDL_GameController *pad = retrodeck_pad;
+		const int x = SDL_GameControllerGetAxis(pad, SDL_CONTROLLER_AXIS_LEFTX);
+		const int y = SDL_GameControllerGetAxis(pad, SDL_CONTROLLER_AXIS_LEFTY);
+		if (y < -14000 || SDL_GameControllerGetButton(pad, SDL_CONTROLLER_BUTTON_DPAD_UP))
+			state |= JOYSTATE_UP;
+		else if (y > 14000 || SDL_GameControllerGetButton(pad, SDL_CONTROLLER_BUTTON_DPAD_DOWN))
+			state |= JOYSTATE_DOWN;
+		if (x < -14000 || SDL_GameControllerGetButton(pad, SDL_CONTROLLER_BUTTON_DPAD_LEFT))
+			state |= JOYSTATE_LEFT;
+		else if (x > 14000 || SDL_GameControllerGetButton(pad, SDL_CONTROLLER_BUTTON_DPAD_RIGHT))
+			state |= JOYSTATE_RIGHT;
+		if (SDL_GameControllerGetButton(pad, SDL_CONTROLLER_BUTTON_A) || SDL_GameControllerGetButton(pad, SDL_CONTROLLER_BUTTON_B))
+			state |= JOYSTATE_BUTTON;
+	}
+	hid_state = (hid_state & ~(JOYSTATE_UP | JOYSTATE_DOWN | JOYSTATE_LEFT | JOYSTATE_RIGHT | JOYSTATE_BUTTON)) | state;
+}
+
+
+// SDL_JOYDEVICEADDED (`which`: the device index) and SDL_JOYDEVICEREMOVED
+// (`which`: the instance ID) for RETRODECK_PAD; false when it is not set
+static int hid_retrodeck_pad_device_event ( int which, int is_attach )
+{
+	if (retrodeck_pad_index < 0)
+		return 0;
+	if (is_attach && which == retrodeck_pad_index && !retrodeck_pad) {
+		retrodeck_pad = SDL_GameControllerOpen(which);
+		if (retrodeck_pad) {
+			retrodeck_pad_id = SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(retrodeck_pad));
+			DEBUGPRINT("HID: RetroDeck's game controller #%d \"%s\" plays." NL, which, SDL_GameControllerName(retrodeck_pad));
+		} else
+			DEBUGPRINT("HID: RetroDeck's game controller #%d cannot be opened: %s" NL, which, SDL_GetError());
+	} else if (!is_attach && retrodeck_pad && which == retrodeck_pad_id) {
+		SDL_GameControllerClose(retrodeck_pad);
+		retrodeck_pad = NULL;
+		retrodeck_pad_id = -1;
+		DEBUGPRINT("HID: RetroDeck's game controller has been removed." NL);
+	}
+	hid_retrodeck_pad_update();
+	return 1;
+}

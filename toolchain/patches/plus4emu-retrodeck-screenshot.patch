+// RETRODECK_SCREENSHOT: the picture shown is saved there for Print or
+// Shift+F12, and when RetroDeck asks for it (SIGUSR2: its controller's
+// View + X), with the next frame the display draws
+static volatile sig_atomic_t retrodeckScreenshotAsked = 0;
+
+static void retrodeckOnScreenshot(int)
+{
+  retrodeckScreenshotAsked = 1;
+}
+
+static void retrodeckScreenshot(void *userData,
+                                const unsigned char *buf, int w_, int h_)
+{
+  (void) userData;
+  try {
+    Plus4Emu::writePNGImage(std::getenv("RETRODECK_SCREENSHOT"), buf, w_, h_,
+                            0, false, 32768);
+  }
+  catch (...) {
+  }
+}

+/* Warp while a drive motor runs (DriveWarpOnActivity), and back to normal
+   speed half a second after the last one stopped; only warp switched on
+   here is switched off here. */
+static void drive_warp_update(void)
+{
+    static int warp_by_drive = 0;
+    static unsigned int frames_still = 0;
+    int spinning = 0;
+    unsigned int dnr;
+
+    if (drive_warp_on_activity) {
+        for (dnr = 0; dnr < NUM_DISK_UNITS; dnr++) {
+            diskunit_context_t *unit = diskunit_context[dnr];
+
+            if (unit->enable
+                && ((unit->drives[0]->byte_ready_active & BRA_MOTOR_ON)
+                    || (drive_check_dual(unit->type)
+                        && (unit->drives[1]->byte_ready_active & BRA_MOTOR_ON)))) {
+                spinning = 1;
+            }
+        }
+    }
+    if (spinning) {
+        frames_still = 0;
+        if (!vsync_get_warp_mode()) {
+            vsync_set_warp_mode(1);
+            warp_by_drive = 1;
+        }
+    } else if (warp_by_drive && ++frames_still >= 25) {
+        if (vsync_get_warp_mode()) {
+            vsync_set_warp_mode(0);
+        }
+        warp_by_drive = 0;
+    }
+}
+

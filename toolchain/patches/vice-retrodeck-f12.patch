+/* RETRODECK_PID: F12 asks RetroDeck, which started VICE, whether to end
+   the game (as the controller's View does); VICE's menu is on another key
+   then (RetroDeck sets MenuKey) */
+static int retrodeck_ask(void)
+{
+    const char *pid = getenv("RETRODECK_PID");
+
+    if (pid == NULL || atoi(pid) <= 0) {
+        return 0;
+    }
+    return kill((pid_t)atoi(pid), SIGUSR1) == 0;
+}

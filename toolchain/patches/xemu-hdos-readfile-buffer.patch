diff --git a/targets/mega65/hdos.c b/targets/mega65/hdos.c
index 6eedee98..bcb0b43e 100644
--- a/targets/mega65/hdos.c
+++ b/targets/mega65/hdos.c
@@ -625,6 +625,9 @@ static void hdos_virt_readfile ( void )
 		hdos.virt_out_a = HDOSERR_READ_ERROR;
 		return;
 	}
+	// Hyppo's readfile leaves the SD-card buffer mapped at $DE00, where programs read the data from;
+	// without that they would see the F011 buffer instead (e.g. with a D81 mounted)
+	sdcard_map_sd_buffer();
 	hdos.virt_out_x =  read_size       & 0xFF;
 	hdos.virt_out_y = (read_size >> 8) & 0xFF;
 	hdos.virt_out_carry = 1;	// signal OK status
diff --git a/targets/mega65/sdcard.c b/targets/mega65/sdcard.c
index 10b87f9b..1fd3960c 100644
--- a/targets/mega65/sdcard.c
+++ b/targets/mega65/sdcard.c
@@ -302,6 +302,14 @@ static XEMU_INLINE void set_disk_buffer_cpu_view ( void )
 }
 
 
+// Maps the SD-card sector buffer at $DE00 ($D689.7 = 1), as Hyppo does when it reads a file
+void sdcard_map_sd_buffer ( void )
+{
+	sd_regs[9] |= 0x80;
+	set_disk_buffer_cpu_view();
+}

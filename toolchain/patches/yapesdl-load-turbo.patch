 /* ---------- MAIN LOOP ---------- */
+// With YAPE_LOAD_TURBO set: as fast as it goes while a drive works (a true
+// drive's motor runs, or the 1551 is talked to), without sound and showing
+// every eighth frame; back to normal half a second after it stopped.
+static bool loadTurbo()
+{
+	static const bool enabled = getenv("YAPE_LOAD_TURBO") != NULL;
+	static unsigned int lastAccesses = 0, framesStill = 0;
+	static bool on = false;
+
+	if (!enabled)
+		return false;
+	bool busy = CFakeTCBM::Accesses != lastAccesses;
+	lastAccesses = CFakeTCBM::Accesses;
+	for (unsigned int i = 0; i < 4; i++) {
+		CTrueDrive *d = CTrueDrive::Drives[i];
+		if (d && d->GetFdc() && d->GetFdc()->getMotorState())
+			busy = true;
+	}
+	if (busy) {
+		framesStill = 0;
+		if (!on) {
+			on = true;
+			if (g_50Hz)
+				sound_pause();
+		}
+	} else if (on && ++framesStill >= 25) {
+		on = false;
+		if (g_50Hz)
+			sound_resume();
+	}
+	return on;
+}

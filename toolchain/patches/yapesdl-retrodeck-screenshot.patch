+// RETRODECK_SCREENSHOT: the picture shown is saved there as a PNG for Print
+// or Shift+F12, and when RetroDeck asks for it (SIGUSR2: its controller's
+// View + X): the frame just emulated, before the frame rate or a message
+// is drawn into it
+static volatile sig_atomic_t retrodeckScreenshot = 0;
+
+static void retrodeckOnScreenshot(int)
+{
+	retrodeckScreenshot = 1;
+}
+
+static void retrodeckSaveScreenshot()
+{
+	static unsigned char rgb[SCREENX * SCREENY * 3];
+	const char *path = getenv("RETRODECK_SCREENSHOT");
+	const unsigned int *palette = palette_get_rgb();
+	const unsigned int pitch = ted8360->getCyclesPerRow();
+	const int offsetX = pitch == VIC_PIXELS_PER_ROW ? -72 : 8;
+	const int offsetY = pitch == VIC_PIXELS_PER_ROW ? 9 : 0;
+	const unsigned char *src = ted8360->getScreenData() + (pitch - 384 - offsetX) / 2 + offsetY * pitch;
+
+	retrodeckScreenshot = 0;
+	if (!path || !*path)
+		return;
+	for (unsigned int y = 0; y < SCREENY; y++) {
+		for (unsigned int x = 0; x < SCREENX; x++) {
+			const unsigned int c = palette[src[y * pitch + x]];
+			unsigned char *p = rgb + (y * SCREENX + x) * 3;
+			p[0] = (unsigned char) (c >> 16);
+			p[1] = (unsigned char) (c >> 8);
+			p[2] = (unsigned char) c;
+		}
+	}
+	if (stbi_write_png(path, SCREENX, SCREENY, 3, rgb, SCREENX * 3))
+		PopupMsg(" SCREENSHOT ");
+}
+
 static void frameUpdate()
 {
 	const unsigned int cyclesPerRow = ted8360->getCyclesPerRow();

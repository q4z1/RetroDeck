+/* RETRODECK_SCREENSHOT: the picture shown is saved there for Print or
+   Shift+F12, and when RetroDeck asks for it (SIGUSR2: its controller's
+   View + X), between two frames (sdlkbd_retrodeck_poll) */
+static volatile sig_atomic_t retrodeck_screenshot_asked = 0;
+
+static void retrodeck_on_screenshot(int sig)
+{
+    retrodeck_screenshot_asked = 1;
+}
+
+static int retrodeck_screenshot(void)
+{
+    const char *path = getenv("RETRODECK_SCREENSHOT");
+
+    if (path == NULL || path[0] == 0) {
+        return 0;
+    }
+    screenshot_save("PNG", path, sdl_active_canvas);
+    return 1;
+}
+
+void sdlkbd_retrodeck_poll(void)
+{
+    if (retrodeck_screenshot_asked) {
+        retrodeck_screenshot_asked = 0;
+        retrodeck_screenshot();
+    }
+}

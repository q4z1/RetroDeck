{
    // Both scripts hand themselves to the host (flatpak-spawn --host) when
    // started from VS Code's Flatpak
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (host)",
            "type": "shell",
            "command": "${workspaceFolder}/build.sh",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run RetroDeck in a window",
            "type": "shell",
            "command": "${workspaceFolder}/retrodeck.sh --window 1280x800",
            "problemMatcher": []
        }
    ]
}
